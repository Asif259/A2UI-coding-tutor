# Optional. AI providers are managed in the app (AI providers button) and stored in
# agent/data/providers.json. On first run, a GEMINI_API_KEY here seeds one Gemini provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Where the provider list (with API keys) is saved.
# PROVIDERS_FILE=data/providers.json
# Set to 1 to run without any model: the agent answers with a canned quiz.
TUTOR_OFFLINE=0
